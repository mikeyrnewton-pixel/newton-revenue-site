-- ATLAS / NEWTON £195 pilot: SQL role-policy acceptance suite (STAGING ONLY).
-- REVIEW-ONLY. Not a production migration; NOT executed by GitHub Actions.
-- Based on Supabase official testing guidance, 25 Oct 2026:
-- https://supabase.com/docs/guides/database/postgres/row-level-security
--
-- Isolated test-DB prerequisites:
-- * Install pgTAP on ISOLATED local/staging PostgreSQL, with Supabase auth helpers.
-- * Reconstruct exact existing newton_opportunities schema and auth.users identity support.
-- * Provision a DUMMY owner auth.users row with synthetic ID below in test DB ONLY.
-- * In a PRIVATE staged copy of ATLAS_DIAGNOSTIC_OWNER_CRM_RLS_20261025.sql.review,
--   substitute dummy owner's UUID for both invalid placeholders;
--   apply guarded candidate after a clean schema snapshot. Never commit substituted SQL.
-- * Run this SQL using a staging admin/test role and supabase test db when available.
-- * Report all assertions, server version, and failure logs before any real change.
-- * This test file creates only SYNTHETIC records in its own rolled-back transaction.
-- * Do not copy tests, dummy identity or records into real project; do not run through
--   the connected production SQL tool.
--
BEGIN;
SELECT plan(19);
SELECT ok(
  (SELECT relrowsecurity FROM pg_class
   WHERE oid='public.newton_opportunities'::regclass),
  'RLS must remain enabled'
);
SELECT is(
  (SELECT count(*)::int FROM pg_policies
   WHERE schemaname='public' AND tablename='newton_opportunities'),
  3,
  'exactly three owner-only policies'
);
SELECT ok(
  NOT has_table_privilege('anon','public.newton_opportunities','SELECT'),
  'signed-out anon role has no SELECT grant'
);
SELECT ok(
  NOT has_table_privilege('anon','public.newton_opportunities','INSERT'),
  'signed-out anon role has no INSERT grant'
);
SELECT ok(
  NOT has_table_privilege('authenticated','public.newton_opportunities','DELETE'),
  'signed-in clients have no DELETE grant'
);
SELECT ok(
  has_table_privilege('authenticated','public.newton_opportunities','INSERT') AND
  has_table_privilege('authenticated','public.newton_opportunities','SELECT') AND
  has_table_privilege('authenticated','public.newton_opportunities','UPDATE'),
  'authenticated role holds needed read/write privileges'
);
-- Owner simulation via DB request claims is NOT a signed JWT verification.
SET LOCAL ROLE authenticated;
SET LOCAL request.jwt.claim.sub = '11111111-1111-4111-8111-111111111111';
SET LOCAL request.jwt.claims = '{"sub":"11111111-1111-4111-8111-111111111111","role":"authenticated","is_anonymous":false}';
SELECT results_eq(
  $$INSERT INTO public.newton_opportunities
     (id, owner_user_id, title, status, source)
     VALUES ('88888888-8888-4888-8888-888888888888',
             '11111111-1111-4111-8111-111111111111',
             'FICTIONAL TEST ONLY', 'discovered','rls_staging_test')
     RETURNING title$$,
  ARRAY['FICTIONAL TEST ONLY'],
  'actual owner insert returns new record'
);
SELECT results_eq(
  $$SELECT title FROM public.newton_opportunities
    WHERE id='88888888-8888-4888-8888-888888888888'$$,
  ARRAY['FICTIONAL TEST ONLY'],
  'actual owner SELECT sees their row'
);
SELECT results_eq(
  $$UPDATE public.newton_opportunities SET title='FICTIONAL UPDATED'
    WHERE id='88888888-8888-4888-8888-888888888888'
    RETURNING title$$,
  ARRAY['FICTIONAL UPDATED'],
  'actual owner UPDATE RETURNING confirms row changed'
);
-- Signed-in NON-owner.
SET LOCAL request.jwt.claim.sub = '22222222-2222-4222-8222-222222222222';
SET LOCAL request.jwt.claims = '{"sub":"22222222-2222-4222-8222-222222222222","role":"authenticated","is_anonymous":false}';
SELECT is_empty(
  $$SELECT title FROM public.newton_opportunities
    WHERE id='88888888-8888-4888-8888-888888888888'$$,
  'non-owner sees zero owner rows'
);
SELECT is_empty(
  $$UPDATE public.newton_opportunities SET title='BREACH'
    WHERE id='88888888-8888-4888-8888-888888888888'
    RETURNING title$$,
  'non-owner changes zero owner rows'
);
SELECT throws_ok(
  $$INSERT INTO public.newton_opportunities (owner_user_id,title)
    VALUES ('22222222-2222-4222-8222-222222222222','BREACH')$$,
  '42501', NULL,
  'non-owner cannot add any row even under their own UID'
);
SELECT throws_ok(
  $$INSERT INTO public.newton_opportunities (owner_user_id,title)
    VALUES ('11111111-1111-4111-8111-111111111111','BREACH')$$,
  '42501', NULL,
  'non-owner cannot impersonate owner via INSERT column'
);
-- Supabase anonymous Auth session assumes authenticated role.
SET LOCAL request.jwt.claim.sub = '11111111-1111-4111-8111-111111111111';
SET LOCAL request.jwt.claims = '{"sub":"11111111-1111-4111-8111-111111111111","role":"authenticated","is_anonymous":true}';
SELECT is_empty(
  $$SELECT title FROM public.newton_opportunities
    WHERE id='88888888-8888-4888-8888-888888888888'$$,
  'anonymous-Auth JWT claim cannot access owner row'
);
SELECT throws_ok(
  $$INSERT INTO public.newton_opportunities (owner_user_id,title)
    VALUES ('11111111-1111-4111-8111-111111111111','BREACH')$$,
  '42501', NULL,
  'anonymous-Auth JWT claim cannot insert'
);
-- Signed-out public key role: grants must deny entry before policy application.
SET LOCAL ROLE anon;
SET LOCAL request.jwt.claim.sub = '';
SET LOCAL request.jwt.claims = '{}';
SELECT throws_ok(
  $$SELECT id FROM public.newton_opportunities LIMIT 1$$,
  '42501', NULL,
  'signed-out role gets 42501 before any read'
);
SELECT throws_ok(
  $$INSERT INTO public.newton_opportunities (owner_user_id,title)
    VALUES ('11111111-1111-4111-8111-111111111111','BREACH')$$,
  '42501', NULL,
  'signed-out role gets 42501 before any insert'
);
-- Check post-denial integrity of original owner row and ownership lock.
SET LOCAL ROLE authenticated;
SET LOCAL request.jwt.claim.sub = '11111111-1111-4111-8111-111111111111';
SET LOCAL request.jwt.claims = '{"sub":"11111111-1111-4111-8111-111111111111","role":"authenticated","is_anonymous":false}';
SELECT results_eq(
  $$SELECT title FROM public.newton_opportunities
    WHERE id='88888888-8888-4888-8888-888888888888'$$,
  ARRAY['FICTIONAL UPDATED'],
  'denied changes did not alter owner row'
);
SELECT throws_ok(
  $$UPDATE public.newton_opportunities
    SET owner_user_id='22222222-2222-4222-8222-222222222222'
    WHERE id='88888888-8888-4888-8888-888888888888'$$,
  '42501', NULL,
  'owner cannot reassign a record to a different user'
);
SELECT * FROM finish();
ROLLBACK;
-- REMAINS UNVERIFIED: JWT signature/expiry/MFA, browser auth, service role isolation,
-- penetration/CSRF/CSP, backup/rollback and production owner sign-off.
